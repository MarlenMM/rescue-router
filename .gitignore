!/requirements.txt
!/requirements-gpu.txt
!/pyproject.toml
!/uv.lock
!/.pre-commit-config.yaml
!/.github/
!/src/
!/app/
!/docs/
!/writeup/
!/slides/
!/kaggle/
!/splits/
!/supports/
!/demo/
!/notebook/
!/release/
!/experiments/
