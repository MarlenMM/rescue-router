# rescue-router repo: track only our own work. The vendored starter (chameleon/, chameleon.ipynb,
# tools/, assets/; its README kept locally as README_starter.md) is cloned from github.com/GitGyun/AIC200-Project-StructuredPrediction
# on Colab; datasets, checkpoints and caches live on Google Drive (PLAN.md §0.3).
/*
!/.gitignore
!/.gitattributes
!/PLAN.md
!/README.md
!/LICENSE
!/CITATION.cff
!/MODEL_CARD.md
!/DATA.md
!/requirements.txt
!/requirements-gpu.txt
!/pyproject.toml
!/uv.lock
!/.pre-commit-config.yaml
!/.github/
!/src/
!/app/
!/docs/
!/writeup/
!/slides/
!/kaggle/
!/splits/
!/supports/
!/demo/
!/notebook/
!/release/
!/experiments/
__pycache__/
*.pyc
.DS_Store
writeup/*.aux
writeup/*.log
writeup/*.out
writeup/writeup.pdf
